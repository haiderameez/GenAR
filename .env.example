# Copy this file to `.env` and fill in your own values.
#
#     cp .env.example .env
#
# `.env` is gitignored and must not be included in the submission package.
# A variable already set in your shell always wins over the value here.

# --- required for --llm gemini -------------------------------------------
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY= 

# --- where the dataset lives ---------------------------------------------
# Not stored in this repository: the data usage notice asks that it not be
# redistributed. Absolute path to your local copy.
GENAR_DATASET=C:/Users/you/Downloads/Bisoprolol_icsr_sample_1068rows.xlsx

# --- model and free-tier limits ------------------------------------------
# Confirm the current model name and your key's actual quota in AI Studio;
# both change, and the defaults below are deliberately conservative.
GENAR_MODEL=gemini-3.6-flash
GENAR_RPM=10
GENAR_DAILY_BUDGET=20
